// Hunt: Directory replication rights used by a non-machine account (possible DCSync)
// DRAFT FOR REVIEW. Converted from rule.yml with: sigma convert -t kusto -p azure_monitor
// The Sigma rule was tested against public datasets (see README "Validation notes"). This KQL has
// converted cleanly but has NOT been run in a Log Analytics / Sentinel workspace.
//
// Hunt ID:   2026-10-25-dcsync-replication-by-non-dc-account
// Table:     SecurityEvent (Microsoft Sentinel / Log Analytics, Windows Security events from domain
//            controllers via the Azure Monitor Agent; needs event 4662 collected, i.e. "All events"
//            or a custom XPath including 4662).
// ATT&CK:    T1003.006
// Source:    https://github.com/CyberThreatNet/hunt-lab | Licence: MIT - see LICENSE
let lookback = 14d;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where (EventID == 4662 and AccessMask =~ "0x100" and (Properties contains "1131f6aa-9c07-11d1-f79f-00c04fc2dcd2" or Properties contains "1131f6ad-9c07-11d1-f79f-00c04fc2dcd2" or Properties contains "89e95b76-444d-4c62-991a-0facbeda640c")) and (not((SubjectUserName endswith "$" or SubjectDomainName =~ "Window Manager" or SubjectUserName startswith "NT AUT")))
// Tuning: exclude your Entra Connect sync account and any other named replication accounts by EXACT
// name, never by prefix (anyone who can create accounts can choose an MSOL_ name), e.g.
// | where SubjectUserName !in~ ("MSOL_0123456789ab", "svc-idsync")
// AccessMask: some pipelines store 0x100 as decimal 256 or as %%7688; adjust the match if yours does.
| project TimeGenerated, Computer, SubjectDomainName, SubjectUserName, SubjectLogonId, ObjectName, Properties
| order by TimeGenerated asc
